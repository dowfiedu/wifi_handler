#!/bin/sh /etc/rc.common
# ==============================================================================
# OpenWrt procd init script for openNDS Telegram Sync Service
# Install location on router: /etc/init.d/opennds_sync
# Permissions: chmod +x /etc/init.d/opennds_sync
# Enable on boot: /etc/init.d/opennds_sync enable
# Start service: /etc/init.d/opennds_sync start
# ==============================================================================

USE_PROCD=1
START=95
STOP=10

PROG="/usr/bin/opennds_sync.sh"
CONF="/etc/opennds/sync.conf"

start_service() {
    if [ ! -x "$PROG" ]; then
        echo "Error: $PROG is missing or not executable."
        return 1
    fi

    if [ ! -f "$CONF" ]; then
        echo "Warning: $CONF not found. Using default environment variables."
    fi

    procd_open_instance "opennds_sync"
    procd_set_param command "$PROG"
    # Auto-respawn with 5s backoff if daemon exits unexpectedly
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    echo "Stopping opennds_sync service..."
}
