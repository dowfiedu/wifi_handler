# ==============================================================================
# Environment Configuration (.env.example)
#
# Copy this file to .env.local for local testing with `vercel dev`,
# and set these variables in your Vercel Project Settings for production.
# ==============================================================================

# 1. Telegram Bot Token
# Obtain from @BotFather on Telegram (e.g., 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Telegram Target Chat ID
# The Chat ID (or group/channel ID) where access requests should be sent.
# You can get your personal ID by sending a message to @userinfobot or checking https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# 3. Upstash Redis REST Credentials
# Create a free Redis database at https://console.upstash.com
# Under Database Details -> REST API, copy the REST URL and REST Token:
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# 4. OpenWrt Router Shared Secret
# A strong random secret key to protect the /api/poll endpoint from unauthorized access.
# Must match the ROUTER_SECRET_KEY in router/sync.sh (or /etc/opennds/sync.conf).
# Generate with: openssl rand -hex 24
ROUTER_SECRET_KEY=generate_a_random_secure_secret_token_here

# 5. Web Admin Dashboard Password (Optional)
# Secret or password to protect the Web Admin Dashboard (/admin).
# If left blank, it automatically falls back to ROUTER_SECRET_KEY above.
ADMIN_PASSWORD=my_strong_admin_web_password_here

# ==============================================================================
# Telegram Webhook Setup Instruction:
#
# Once deployed to Vercel, register your webhook with the Telegram Bot API:
# curl -X POST "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook" \
#      -H "Content-Type: application/json" \
#      -d '{"url": "https://<your-vercel-domain>.vercel.app/api/webhook"}'
# ==============================================================================
